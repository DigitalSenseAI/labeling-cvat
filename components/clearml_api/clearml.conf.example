{
    "_comment": "Copy this file to clearml.conf and replace with your actual values",
    "api": {
        "host": "http://your-clearml-server:8008",
        "web_host": "http://your-clearml-server:8083",
        "files_host": "http://your-clearml-server:8082",
        "key": "YOUR_CLEARML_API_KEY",
        "secret": "YOUR_CLEARML_API_SECRET",
        "cors_allowed_origins": ["http://your-frontend-host:port"]
    },
    "sdk": {
        "metrics": {
            "metrics_interval_sec": 60
        },
        "storage": {
            "cache": {
                "default_base_dir": "/tmp/clearml_cache"
            }
        },
        "network": {
            "metrics": {
                "file_upload_threads": 4,
                "file_upload_starvation_warning_sec": 120
            },
            "iteration": {
                "max_retries_on_server_error": 5,
                "retry_backoff_factor_sec": 10
            }
        }
    }
}
